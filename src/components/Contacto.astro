---
import DecorativeBlob from './DecorativeBlob.astro';

interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const WHATSAPP_URL = 'https://wa.me/+50767827835';
const sectionId = lang === 'es' ? 'contacto' : 'contact';

const copy = {
  es: {
    heading: '¿Lista para que tu contenido trabaje más, no que tú trabajes más?',
    cta: 'Hablemos de tu proyecto',
  },
  en: {
    heading: 'Ready for your content to work harder, not you?',
    cta: "Let's talk about your project",
  },
};

const t = copy[lang];
---

<section id={sectionId} class="contacto-section reveal">
  <DecorativeBlob color="var(--color-accent)" opacity={0.35} />
  <div class="contacto-inner">
    <h2>{t.heading}</h2>
    <a
      class="contacto-cta"
      href={WHATSAPP_URL}
      target="_blank"
      rel="noopener noreferrer"
    >
      {t.cta}
    </a>
  </div>
</section>

<style>
  .contacto-section {
    position: relative;
    overflow: hidden;
    background-color: var(--color-bg);
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 5rem 1.25rem;
  }

  .contacto-inner {
    position: relative;
    max-width: 780px;
    margin: 0 auto;
    text-align: center;
  }

  .contacto-inner h2 {
    font-size: clamp(2rem, 6vw, 3.5rem);
    line-height: 1.25;
    margin: 0 0 2.5rem;
  }

  .contacto-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1.15rem;
    background-color: var(--color-accent-strong);
    color: var(--color-cta-text);
    border-radius: 999px;
    padding: 1.1rem 2.5rem;
    text-decoration: none;
    min-height: 52px;
    transition: filter 0.15s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .contacto-cta:hover {
    filter: brightness(0.9);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.12);
  }

  @media (max-width: 480px) {
    .contacto-section {
      padding: 4rem 1rem;
      min-height: 60vh;
    }

    .contacto-inner h2 {
      margin-bottom: 2rem;
    }

    .contacto-cta {
      width: 100%;
    }
  }
</style>
