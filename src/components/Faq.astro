---
import QuestionIcon from './icons/QuestionIcon.astro';

const faqs = [
  {
    pregunta: '¿Necesito tener ya una cuenta de Pinterest para empezar?',
    respuesta: 'No, puedo ayudarte a crearla y configurarla desde cero.',
  },
  {
    pregunta: '¿Necesito crear contenido nuevo para esto?',
    respuesta:
      'No necesariamente. Mi especialidad es tomar lo que ya tienes (blogs, reels, testimonios) y convertirlo en pines nuevos.',
  },
  {
    pregunta: '¿Cuánto tiempo toma ver resultados?',
    respuesta:
      'Pinterest funciona distinto a otras redes. Los resultados suelen ser más lentos al inicio pero mucho más duraderos: un pin bien optimizado puede seguir generando tráfico meses después.',
  },
];
---

<section id="faq" class="faq-section reveal">
  <div class="section-inner">
    <div class="faq-heading-row">
      <div class="faq-icon-badge">
        <QuestionIcon size={26} />
      </div>
      <h2>Preguntas frecuentes</h2>
    </div>

    <div class="faq-list">
      {faqs.map(({ pregunta, respuesta }) => (
        <details class="faq-item">
          <summary class="faq-question">
            <span>{pregunta}</span>
            <span class="faq-toggle" aria-hidden="true">
              <span class="faq-toggle-plus">+</span>
              <span class="faq-toggle-minus">−</span>
            </span>
          </summary>
          <div class="faq-answer">
            <p>{respuesta}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-section {
    background-color: var(--color-bg);
    padding: 4rem 1.25rem;
  }

  .section-inner {
    max-width: 780px;
    margin: 0 auto;
  }

  .faq-heading-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .faq-icon-badge {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-accent);
  }

  h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin: 0;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .faq-item {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 0;
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-heading);
    font-size: 1.05rem;
    color: var(--color-text);
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question::marker {
    display: none;
  }

  .faq-toggle {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background-color: var(--color-bg);
    color: var(--color-accent-strong);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1.1rem;
  }

  .faq-toggle-minus {
    display: none;
  }

  details[open] .faq-toggle-plus {
    display: none;
  }

  details[open] .faq-toggle-minus {
    display: inline;
  }

  .faq-answer {
    padding: 0 1.5rem 1.25rem;
  }

  .faq-answer p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-text);
    max-width: 65ch;
  }

  @media (max-width: 480px) {
    .faq-section {
      padding: 3rem 1rem;
    }

    .faq-question {
      padding: 1rem 1.1rem;
      font-size: 1rem;
    }

    .faq-answer {
      padding: 0 1.1rem 1rem;
    }
  }
</style>
