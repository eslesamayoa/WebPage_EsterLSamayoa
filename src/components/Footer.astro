---
interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const base = import.meta.env.BASE_URL;
const WHATSAPP_URL = 'https://wa.me/+50767827835';

const copy = {
  es: {
    ariaLinks: 'Enlaces rápidos',
    servicios: 'Servicios',
    sobreMi: 'Sobre mí',
    faq: 'Preguntas frecuentes',
    servicesHref: `${base}servicios`,
    aboutHref: `${base}sobre-mi`,
    faqHref: `${base}#faq`,
    cta: 'Hablemos de tu proyecto',
    credit: 'Diseñada y desarrollada por Lina Smith & Daniel Newman — Click & Minds',
  },
  en: {
    ariaLinks: 'Quick links',
    servicios: 'Services',
    sobreMi: 'About',
    faq: 'FAQ',
    servicesHref: `${base}en/services`,
    aboutHref: `${base}en/about`,
    faqHref: `${base}en/#faq`,
    cta: "Let's talk about your project",
    credit: 'Designed & built by Lina Smith & Daniel Newman — Click & Minds',
  },
};

const t = copy[lang];
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <img
        class="footer-logo"
        src={`${base}images/brand/footer-logo-vertical.png`}
        alt="Esther L. Samayoa"
        width="1254"
        height="1254"
      />
    </div>

    <nav class="footer-links" aria-label={t.ariaLinks}>
      <a href={t.servicesHref}>{t.servicios}</a>
      <a href={t.aboutHref}>{t.sobreMi}</a>
      <a href={t.faqHref}>{t.faq}</a>
    </nav>

    <div class="footer-cta">
      <a
        class="footer-cta-button"
        href={WHATSAPP_URL}
        target="_blank"
        rel="noopener noreferrer"
      >
        {t.cta}
      </a>
    </div>
  </div>

  <div class="footer-bottom">
    <p>© 2026 Esther L. Samayoa</p>
    <p class="footer-credit">{t.credit}</p>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-text);
    padding-top: 3rem;
  }

  .footer-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    align-items: center;
    gap: 2rem;
    padding: 0 1.25rem 2.5rem;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .footer-logo {
    display: block;
    width: 96px;
    height: auto;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
  }

  .footer-links a {
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.92);
    text-decoration: none;
  }

  .footer-links a:hover {
    text-decoration: underline;
  }

  .footer-cta {
    display: flex;
    justify-content: flex-end;
  }

  .footer-cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.95rem;
    background-color: var(--color-accent-strong);
    color: var(--color-cta-text);
    border-radius: 999px;
    padding: 0.85rem 1.75rem;
    text-decoration: none;
    min-height: 48px;
    transition: filter 0.15s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .footer-cta-button:hover {
    filter: brightness(0.9);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.25);
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    padding: 1.25rem 1.25rem;
  }

  .footer-bottom p {
    margin: 0;
    text-align: center;
    font-family: var(--font-body);
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.65);
  }

  .footer-bottom .footer-credit {
    margin-top: 0.4rem;
    font-size: 0.68rem;
    color: rgba(255, 255, 255, 0.4);
  }

  @media (max-width: 700px) {
    .footer-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .footer-brand {
      align-items: center;
    }

    .footer-links {
      order: 2;
    }

    .footer-cta {
      order: 3;
      justify-content: center;
    }

    .footer-brand {
      order: 1;
    }
  }

  @media (max-width: 480px) {
    .footer-cta-button {
      width: 100%;
    }
  }
</style>
