---
const base = import.meta.env.BASE_URL;
const WHATSAPP_URL = 'https://wa.me/+50767827835';
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <div class="footer-logo-card">
        <img
          src={`${base}images/brand/footer-logo-vertical.png`}
          alt="Esther L. Samayoa"
          width="260"
          height="225"
        />
      </div>
      <p class="footer-tagline">Pinterest Manager para coaches y podcasters</p>
    </div>

    <nav class="footer-links" aria-label="Enlaces rápidos">
      <a href={`${base}servicios`}>Servicios</a>
      <a href={`${base}sobre-mi`}>Sobre mí</a>
      <a href={`${base}#faq`}>Preguntas frecuentes</a>
    </nav>

    <div class="footer-cta">
      <a
        class="footer-cta-button"
        href={WHATSAPP_URL}
        target="_blank"
        rel="noopener noreferrer"
      >
        Agenda tu llamada
      </a>
    </div>
  </div>

  <div class="footer-bottom">
    <p>© 2026 Esther L. Samayoa</p>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-text);
    padding-top: 3rem;
  }

  .footer-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    align-items: center;
    gap: 2rem;
    padding: 0 1.25rem 2.5rem;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
  }

  .footer-logo-card {
    display: inline-flex;
    background-color: var(--color-surface);
    border-radius: 12px;
    padding: 0.75rem 1rem;
  }

  .footer-logo-card img {
    width: 72px;
    height: auto;
  }

  .footer-tagline {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.75);
    max-width: 220px;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
  }

  .footer-links a {
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.92);
    text-decoration: none;
  }

  .footer-links a:hover {
    text-decoration: underline;
  }

  .footer-cta {
    display: flex;
    justify-content: flex-end;
  }

  .footer-cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.95rem;
    background-color: var(--color-accent-strong);
    color: var(--color-cta-text);
    border-radius: 999px;
    padding: 0.85rem 1.75rem;
    text-decoration: none;
    min-height: 48px;
    transition: filter 0.15s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .footer-cta-button:hover {
    filter: brightness(0.9);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.25);
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    padding: 1.25rem 1.25rem;
  }

  .footer-bottom p {
    margin: 0;
    text-align: center;
    font-family: var(--font-body);
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.65);
  }

  @media (max-width: 700px) {
    .footer-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .footer-brand {
      align-items: center;
    }

    .footer-links {
      order: 2;
    }

    .footer-cta {
      order: 3;
      justify-content: center;
    }

    .footer-brand {
      order: 1;
    }
  }

  @media (max-width: 480px) {
    .footer-cta-button {
      width: 100%;
    }
  }
</style>
