---
import LanguageToggle from './LanguageToggle.astro';

interface Props {
  lang?: 'es' | 'en';
  altHref?: string;
}

const { lang = 'es', altHref = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
const homeHref = lang === 'es' ? base : `${base}en/`;

const copy = {
  es: {
    ariaNav: 'Navegación principal',
    ariaOpen: 'Abrir menú',
    ariaClose: 'Cerrar menú',
    servicios: 'Servicios',
    sobreMi: 'Sobre mí',
    faq: 'Preguntas frecuentes',
    contacto: 'Contacto',
    servicesHref: `${base}servicios`,
    aboutHref: `${base}sobre-mi`,
    faqHref: `${base}#faq`,
    contactHref: `${base}#contacto`,
  },
  en: {
    ariaNav: 'Main navigation',
    ariaOpen: 'Open menu',
    ariaClose: 'Close menu',
    servicios: 'Services',
    sobreMi: 'About',
    faq: 'FAQ',
    contacto: 'Contact',
    servicesHref: `${base}en/services`,
    aboutHref: `${base}en/about`,
    faqHref: `${base}en/#faq`,
    contactHref: `${base}en/#contact`,
  },
};

const t = copy[lang];
---

<header class="site-header" id="site-header">
  <div class="site-header-inner">
    <a class="logo-link" href={homeHref}>
      <img
        class="logo-image"
        src={`${base}images/brand/header-logo.png`}
        alt="Esther L. Samayoa"
      />
    </a>
    <button
      class="menu-toggle"
      id="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label={t.ariaOpen}
      data-label-open={t.ariaOpen}
      data-label-close={t.ariaClose}
    >
      <span class="menu-icon" aria-hidden="true">
        <span></span><span></span><span></span>
      </span>
    </button>
    <nav class="site-nav" aria-label={t.ariaNav} id="site-nav">
      <a href={t.servicesHref}>{t.servicios}</a>
      <a href={t.aboutHref}>{t.sobreMi}</a>
      <a href={t.faqHref}>{t.faq}</a>
      <a href={t.contactHref}>{t.contacto}</a>
      {altHref && <LanguageToggle lang={lang} altHref={altHref} />}
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('menu-toggle');
  const nav = document.getElementById('site-nav');

  if (header && toggle && nav) {
    const openLabel = toggle.dataset.labelOpen || 'Abrir menú';
    const closeLabel = toggle.dataset.labelClose || 'Cerrar menú';

    const closeMenu = () => {
      header.classList.remove('is-open');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', openLabel);
    };

    const openMenu = () => {
      header.classList.add('is-open');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', closeLabel);
    };

    toggle.addEventListener('click', () => {
      if (header.classList.contains('is-open')) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    nav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    document.addEventListener('click', (event) => {
      if (!header.contains(event.target)) {
        closeMenu();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        closeMenu();
      }
    });

    const desktopQuery = window.matchMedia('(min-width: 768px)');
    desktopQuery.addEventListener('change', (event) => {
      if (event.matches) {
        closeMenu();
      }
    });
  }
</script>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
  }

  .logo-link {
    display: inline-flex;
    align-items: center;
  }

  .logo-image {
    height: 44px;
    width: auto;
    display: block;
  }

  .menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }

  .menu-icon {
    position: relative;
    display: inline-block;
    width: 22px;
    height: 16px;
  }

  .menu-icon span {
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    border-radius: 2px;
    background-color: var(--color-text);
    transition: transform 0.25s ease, opacity 0.25s ease, top 0.25s ease;
  }

  .menu-icon span:nth-child(1) {
    top: 0;
  }

  .menu-icon span:nth-child(2) {
    top: 7px;
  }

  .menu-icon span:nth-child(3) {
    top: 14px;
  }

  .site-header.is-open .menu-icon span:nth-child(1) {
    top: 7px;
    transform: rotate(45deg);
  }

  .site-header.is-open .menu-icon span:nth-child(2) {
    opacity: 0;
  }

  .site-header.is-open .menu-icon span:nth-child(3) {
    top: 7px;
    transform: rotate(-45deg);
  }

  .site-nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .site-nav a {
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 4px;
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }

  .site-nav a:hover {
    color: var(--color-accent-strong);
    text-decoration-color: currentColor;
  }

  @media (max-width: 767px) {
    .menu-toggle {
      display: flex;
    }

    .site-nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      flex-wrap: nowrap;
      gap: 0;
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      background-color: var(--color-surface);
      border-bottom: 1px solid var(--color-border);
      box-shadow: 0 12px 20px rgba(0, 0, 0, 0.08);
      transition: max-height 0.3s ease, opacity 0.25s ease;
    }

    .site-header.is-open .site-nav {
      max-height: 400px;
      opacity: 1;
    }

    .site-nav a {
      padding: 0.9rem 1.25rem;
      border-top: 1px solid var(--color-border);
      min-height: 48px;
      display: flex;
      align-items: center;
    }

    .site-nav :global(.language-toggle) {
      justify-content: center;
      padding: 0.9rem 1.25rem;
      border-top: 1px solid var(--color-border);
      min-height: 48px;
    }
  }
</style>
