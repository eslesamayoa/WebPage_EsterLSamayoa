---
interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const base = import.meta.env.BASE_URL;
const WHATSAPP_URL = 'https://wa.me/+50767827835';

const copy = {
  es: {
    headline: 'Tu contenido ya existe. Yo lo convierto en tráfico constante en Pinterest.',
    subheadline:
      'Ayudo a coaches, creadoras, podcasters y dueñas de negocio a transformar el contenido que ya publicaron (blogs, reels, guías, testimonios) en pines optimizados que Pinterest sigue mostrando durante meses, no días.',
    cta: 'Hablemos de tu proyecto',
    secondary: 'Conoce más sobre mí',
    secondaryHref: `${base}sobre-mi`,
  },
  en: {
    headline: 'Your content already exists. I turn it into consistent traffic on Pinterest.',
    subheadline:
      'I help coaches, creators, podcasters and business owners transform the content they already published (blogs, reels, guides, testimonials) into optimized pins that Pinterest keeps showing for months, not days.',
    cta: "Let's talk about your project",
    secondary: 'Learn more about me',
    secondaryHref: `${base}en/about`,
  },
};

const t = copy[lang];
---

<section
  class="hero reveal"
  style={`background-image: url(${base}images/fotos-perfil/foto-perfil-1-hero.jpg);`}
>
  <div class="hero-overlay" aria-hidden="true"></div>
  <div class="hero-inner">
    <img
      class="hero-icon-mark"
      src={`${base}images/brand/icon-mark.png`}
      alt=""
      aria-hidden="true"
      width="40"
      height="40"
    />
    <h1>{t.headline}</h1>
    <p class="hero-subheadline">
      {t.subheadline}
    </p>
    <a
      class="cta-button"
      href={WHATSAPP_URL}
      target="_blank"
      rel="noopener noreferrer"
    >
      {t.cta} <span aria-hidden="true">→</span>
    </a>
    <a class="hero-secondary-link" href={t.secondaryHref}>{t.secondary}</a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background-size: cover;
    background-position: center;
    padding: 6rem 1.25rem;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background-color: var(--color-text);
    opacity: 0.18;
  }

  .hero-inner {
    position: relative;
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    padding: clamp(1.75rem, 4vw, 2.75rem) clamp(1.5rem, 5vw, 2.5rem);
    border-radius: 24px;
    background-color: color-mix(in srgb, var(--color-text) 60%, transparent);
  }

  .hero-icon-mark {
    display: block;
    width: 40px;
    height: 40px;
    margin: 0 auto 1.5rem;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.35));
  }

  .hero h1 {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5.5vw, 3.25rem);
    line-height: 1.15;
    color: var(--color-surface);
    margin: 0 0 1.5rem;
  }

  .hero-subheadline {
    font-family: var(--font-body);
    font-size: clamp(1rem, 2vw, 1.15rem);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.88);
    margin: 0 auto 2.5rem;
    max-width: 60ch;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1rem;
    background-color: var(--color-accent-strong);
    color: var(--color-cta-text);
    border: none;
    border-radius: 999px;
    padding: 0.9rem 2rem;
    text-decoration: none;
    transition: filter 0.15s ease, transform 0.2s ease, box-shadow 0.2s ease;
    min-height: 48px;
  }

  .cta-button:hover {
    filter: brightness(0.9);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.12);
  }

  .hero-secondary-link {
    display: block;
    margin-top: 1.25rem;
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.8);
    text-decoration: underline;
  }

  .hero-secondary-link:hover {
    color: var(--color-surface);
  }

  @media (max-width: 480px) {
    .hero {
      padding: 3rem 1rem;
    }

    .cta-button {
      width: 100%;
    }
  }
</style>
