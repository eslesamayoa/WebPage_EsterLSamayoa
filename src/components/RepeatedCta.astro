---
interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const WHATSAPP_URL = 'https://wa.me/+50767827835';

const copy = {
  es: {
    question: '¿Tienes contenido listo para convertir en tráfico?',
    cta: 'Hablemos de tu proyecto',
  },
  en: {
    question: 'Do you have content ready to turn into traffic?',
    cta: "Let's talk about your project",
  },
};

const t = copy[lang];
---

<section class="repeated-cta reveal">
  <div class="repeated-cta-inner">
    <p>{t.question}</p>
    <a
      class="repeated-cta-button"
      href={WHATSAPP_URL}
      target="_blank"
      rel="noopener noreferrer"
    >
      {t.cta}
    </a>
  </div>
</section>

<style>
  .repeated-cta {
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding: 2.5rem 1.25rem;
  }

  .repeated-cta-inner {
    max-width: 700px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .repeated-cta-inner p {
    margin: 0;
    font-size: 1.05rem;
    color: var(--color-text);
  }

  .repeated-cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.95rem;
    background-color: var(--color-accent-strong);
    color: var(--color-cta-text);
    border-radius: 999px;
    padding: 0.75rem 1.75rem;
    text-decoration: none;
    min-height: 48px;
    transition: filter 0.15s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .repeated-cta-button:hover {
    filter: brightness(0.9);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.12);
  }

  @media (max-width: 480px) {
    .repeated-cta {
      padding: 2rem 1rem;
    }

    .repeated-cta-inner {
      flex-direction: column;
      text-align: center;
    }

    .repeated-cta-button {
      width: 100%;
    }
  }
</style>
