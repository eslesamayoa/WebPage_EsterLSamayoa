---
import DecorativeBlob from './DecorativeBlob.astro';
import RepurposeArrowIcon from './icons/RepurposeArrowIcon.astro';

interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const base = import.meta.env.BASE_URL;

const copy = {
  es: {
    heading: 'Le doy una segunda vida al contenido que ya tienes.',
    body:
      'Tomo el contenido que ya produjiste (posts de blog, reels, testimonios, guías, lead magnets) y lo rediseño en pines nuevos, optimizados con SEO de Pinterest, para que sigan trabajando por ti mucho después de publicados. Esto se llama repurposing, y es una de las formas más rentables de aprovechar el contenido que ya creaste sin duplicar tu carga de trabajo.',
    secondary: 'Ver todos los servicios',
    secondaryHref: `${base}servicios`,
  },
  en: {
    heading: 'I give a second life to the content you already have.',
    body:
      'I take the content you already produced (blog posts, reels, testimonials, guides, lead magnets) and redesign it into new pins, optimized with Pinterest SEO, so they keep working for you long after they were published. This is called repurposing, and it is one of the most profitable ways to make the most of the content you already created without duplicating your workload.',
    secondary: 'See all services',
    secondaryHref: `${base}en/services`,
  },
};

const t = copy[lang];
---

<section class="solucion reveal">
  <DecorativeBlob opacity={0.3} />
  <div class="solucion-inner">
    <div class="solucion-heading-row">
      <div class="solucion-icon-badge">
        <RepurposeArrowIcon size={26} />
      </div>
      <h2>
        {t.heading}
      </h2>
    </div>
    <p>
      {t.body}
    </p>
    <a class="solucion-secondary-link" href={t.secondaryHref}>{t.secondary}</a>
  </div>
</section>

<style>
  .solucion {
    position: relative;
    overflow: hidden;
    background-color: var(--color-bg);
    padding: 4rem 1.25rem;
  }

  .solucion-inner {
    position: relative;
    max-width: 700px;
    margin: 0 auto;
    padding-left: 1.5rem;
    border-left: 4px solid var(--color-accent);
  }

  .solucion-heading-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .solucion-icon-badge {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-accent);
  }

  .solucion h2 {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    line-height: 1.25;
    color: var(--color-text);
    margin: 0;
  }

  .solucion p {
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.8vw, 1.1rem);
    line-height: 1.7;
    color: var(--color-text);
    margin: 0 0 1.75rem;
  }

  .solucion-secondary-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.95rem;
    background-color: transparent;
    color: var(--color-text);
    border: 2px solid var(--color-primary);
    border-radius: 999px;
    padding: calc(0.7rem - 2px) calc(1.5rem - 2px);
    text-decoration: none;
    min-height: 44px;
    transition: background-color 0.15s ease, transform 0.2s ease;
  }

  .solucion-secondary-link:hover {
    background-color: var(--color-surface);
    transform: translateY(-2px);
  }

  @media (max-width: 480px) {
    .solucion {
      padding: 3rem 1rem;
    }

    .solucion-inner {
      padding-left: 1rem;
      border-left-width: 3px;
    }

    .solucion-heading-row {
      align-items: flex-start;
      gap: 0.75rem;
    }

    .solucion-icon-badge {
      width: 42px;
      height: 42px;
    }
  }
</style>
