---
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/700.css';
import '@fontsource/marcellus/400.css';

import '../styles/tokens/palette.css';
import AnnouncementBar from '../components/AnnouncementBar.astro';

interface Props {
  lang: string;
  title: string;
  noindex?: boolean;
  path?: string;
  altPath?: string;
}

const { lang, title, noindex = false, path, altPath } = Astro.props;

const base = import.meta.env.BASE_URL;
const site = Astro.site;
const altLang = lang === 'es' ? 'en' : 'es';
const selfUrl = site && path !== undefined ? new URL(`${base}${path}`, site).toString() : undefined;
const altUrl = site && altPath !== undefined ? new URL(`${base}${altPath}`, site).toString() : undefined;
---

<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={`${import.meta.env.BASE_URL}favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${import.meta.env.BASE_URL}favicon-16x16.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex" />}
    {selfUrl && altUrl && (
      <>
        <link rel="alternate" hreflang={lang} href={selfUrl} />
        <link rel="alternate" hreflang={altLang} href={altUrl} />
        <link rel="alternate" hreflang="x-default" href={lang === 'es' ? selfUrl : altUrl} />
      </>
    )}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    {!noindex && <AnnouncementBar lang={lang === 'en' ? 'en' : 'es'} />}
    <slot />
    <script>
      const hash = window.location.hash;
      if (hash) {
        const target = document.querySelector(hash);
        if (target) {
          const prefersReducedMotion = window.matchMedia(
            '(prefers-reduced-motion: reduce)'
          ).matches;
          requestAnimationFrame(() => {
            target.scrollIntoView({
              behavior: prefersReducedMotion ? 'auto' : 'smooth',
              block: 'start',
            });
          });
        }
      }
    </script>
    <script>
      const prefersReducedMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;
      const revealEls = document.querySelectorAll('.reveal');

      if (prefersReducedMotion || !('IntersectionObserver' in window)) {
        revealEls.forEach((el) => el.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                obs.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15 }
        );
        revealEls.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
    scroll-behavior: smooth;
  }

  /* Scroll reveal: hidden only once JS confirms it can animate it back in,
     so a no-JS visitor always sees full content immediately. */
  html.js .reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.4s ease, transform 0.4s ease;
    will-change: opacity, transform;
  }

  html.js .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
    will-change: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    * {
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }

    html.js .reveal {
      opacity: 1;
      transform: none;
    }
  }

  body {
    margin: 0;
    background-color: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.6;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: var(--font-heading);
    color: var(--color-text);
    margin: 0;
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  a {
    color: var(--color-accent-strong);
  }
</style>
