---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout lang="en" title="About, Esther L. Samayoa" path="en/about" altPath="sobre-mi">
  <Header lang="en" altHref={`${base}sobre-mi`} />

  <main>
    <section class="sobre-mi-section reveal">
      <div class="sobre-mi-inner">
        <div class="sobre-mi-photo">
          <img
            src={`${base}images/fotos-perfil/foto-perfil-2.jpg`}
            alt="Esther L. Samayoa"
            width="1024"
            height="1280"
          />
        </div>
        <div class="sobre-mi-content">
          <p class="sobre-mi-eyebrow">Get to know me</p>
          <h1>I turn your content into traffic that never stops.</h1>
          <p class="sobre-mi-bio">
            I am Esther L. Samayoa, a Pinterest Manager specialized in
            content repurposing for coaches and podcasters. You create
            amazing content, and then watch it disappear from a feed in
            less than 48 hours. I take that content (podcast episodes,
            blog posts, social media content) and turn it into a growth
            engine on Pinterest that keeps working long after the
            original post disappeared, all fully asynchronously. I help
            coaches and podcasters with Pinterest strategy and
            management, content repurposing, and support in English,
            Spanish and Italian. My way of working is 100% asynchronous:
            no calls, no fixed schedule, just clear deliverables and
            constant communication, so you can focus on creating while
            your Pinterest channel keeps growing in the background.
          </p>
          <a
            class="linkedin-cta"
            href="https://www.linkedin.com/in/eslesamayoa/"
            target="_blank"
            rel="noopener noreferrer"
          >
            Connect with me on LinkedIn
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer lang="en" />
</BaseLayout>

<style>
  .sobre-mi-section {
    background-color: var(--color-bg);
    padding: 4rem 1.25rem;
  }

  .sobre-mi-inner {
    max-width: 1000px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 3.5rem;
  }

  .sobre-mi-photo {
    flex: 0 0 auto;
    width: clamp(260px, 32vw, 380px);
  }

  .sobre-mi-photo img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 20px;
  }

  .sobre-mi-content {
    flex: 1;
    min-width: 0;
    text-align: left;
  }

  .sobre-mi-eyebrow {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-accent);
    margin: 0 0 0.85rem;
  }

  .sobre-mi-content h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.2;
    margin: 0 0 1.25rem;
  }

  .sobre-mi-bio {
    font-size: clamp(1rem, 1.8vw, 1.1rem);
    line-height: 1.7;
    color: var(--color-text);
    margin: 0 0 2rem;
    max-width: 55ch;
  }

  .linkedin-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1rem;
    background-color: transparent;
    color: var(--color-text);
    border: 2px solid var(--color-primary);
    border-radius: 999px;
    padding: calc(0.85rem - 2px) calc(1.75rem - 2px);
    text-decoration: none;
    min-height: 48px;
    transition: background-color 0.15s ease, transform 0.2s ease;
  }

  .linkedin-cta:hover {
    background-color: var(--color-surface);
    transform: translateY(-2px);
  }

  @media (max-width: 700px) {
    .sobre-mi-inner {
      flex-direction: column;
      text-align: center;
      gap: 2rem;
    }

    .sobre-mi-photo {
      width: min(260px, 70vw);
    }

    .sobre-mi-content {
      text-align: center;
    }

    .sobre-mi-bio {
      margin-left: auto;
      margin-right: auto;
    }
  }

  @media (max-width: 480px) {
    .sobre-mi-section {
      padding: 3rem 1rem;
    }
  }
</style>
