---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Problema from '../components/Problema.astro';
import Solucion from '../components/Solucion.astro';
import RepeatedCta from '../components/RepeatedCta.astro';
import Faq from '../components/Faq.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout lang="es" title="Esther Levy" path="" altPath="en/">
  <Header lang="es" altHref={`${base}en/`} />
  <Hero lang="es" />
  <Problema lang="es" />
  <Solucion lang="es" />
  <RepeatedCta lang="es" />
  <Faq lang="es" />
  <Contacto lang="es" />
  <Footer lang="es" />
</BaseLayout>
