---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchTrendIcon from '../components/icons/SearchTrendIcon.astro';
import RepurposeArrowIcon from '../components/icons/RepurposeArrowIcon.astro';
import ChartUpIcon from '../components/icons/ChartUpIcon.astro';
import HandsLaptopIcon from '../components/icons/HandsLaptopIcon.astro';
import CalendarCheckIcon from '../components/icons/CalendarCheckIcon.astro';

const base = import.meta.env.BASE_URL;
const WHATSAPP_URL = 'https://wa.me/50767827835';

const servicios = [
  {
    Icon: SearchTrendIcon,
    titulo: 'Auditoría + Optimización de Perfil',
    texto:
      'Reviso tu cuenta actual, corrijo tu bio, tableros y configuración para que Pinterest empiece a mostrarte a la audiencia correcta desde el día uno.',
  },
  {
    Icon: RepurposeArrowIcon,
    titulo: 'Repurposing Mensual de Contenido',
    texto:
      'Cada mes, tomo tu contenido existente y lo transformo en un set de pines nuevos, con descripciones optimizadas por palabra clave y diseño alineado a tu marca.',
  },
  {
    Icon: ChartUpIcon,
    titulo: 'Gestión Completa de Pinterest',
    texto:
      'Estrategia, diseño, programación y reportes de resultados. Tú sigues creando contenido en tus otras plataformas, yo me encargo de que Pinterest trabaje para ti en piloto automático.',
  },
];

const planes = [
  {
    nombre: 'STARTER',
    precio: '$150',
    sufijo: '/ pieza',
    destacado: false,
    idealPara: 'Coaches/podcasters que recién empiezan a repurposear contenido',
    filas: [
      ['Pines de Pinterest', '5 pines (imagen + copy)'],
      ['Captions sociales', '3 (Instagram / LinkedIn)'],
      ['Newsletter', '—'],
      ['Quote graphics (copy)', '—'],
      ['Tiempo de entrega', '3 días hábiles'],
      ['Rondas de revisión', '1'],
      ['Modalidad', '100% async, sin llamadas'],
    ],
  },
  {
    nombre: 'GROWTH',
    precio: '$200',
    sufijo: '/ pieza',
    destacado: true,
    idealPara: 'Creadores que publican contenido regularmente y quieren presencia multicanal',
    filas: [
      ['Pines de Pinterest', '8 pines optimizados con keywords'],
      ['Captions sociales', '5 (Instagram / LinkedIn / X)'],
      ['Newsletter', '1 blurb para email'],
      ['Quote graphics (copy)', '—'],
      ['Tiempo de entrega', '4 días hábiles'],
      ['Rondas de revisión', '1'],
      ['Modalidad', '100% async, sin llamadas'],
    ],
  },
  {
    nombre: 'FULL REPURPOSING',
    precio: '$250',
    sufijo: '/ pieza',
    destacado: false,
    idealPara: 'Marcas establecidas que quieren máxima visibilidad de cada pieza de contenido',
    filas: [
      ['Pines de Pinterest', '12 pines optimizados + sugerencia de tablero'],
      ['Captions sociales', 'Paquete completo, carrusel IG + captions, post LinkedIn, hilo de X'],
      ['Newsletter', '1 blurb para email'],
      ['Quote graphics (copy)', '3 quotes extraídas de la pieza'],
      ['Tiempo de entrega', '5 días hábiles'],
      ['Rondas de revisión', '2'],
      ['Modalidad', '100% async, sin llamadas'],
    ],
  },
];

const pasos = [
  {
    Icon: HandsLaptopIcon,
    titulo: 'Envías tu contenido existente',
    texto: 'Blogs, reels, guías, testimonios, lo que ya tengas.',
  },
  {
    Icon: SearchTrendIcon,
    titulo: 'Investigo y diseño',
    texto: 'Busco las palabras clave correctas y creo los pines.',
  },
  {
    Icon: CalendarCheckIcon,
    titulo: 'Programo y reporto',
    texto: 'Todo publicado en tu cuenta con reportes claros de resultados.',
  },
];

const herramientas = [
  { nombre: 'Canva', src: 'images/brand/tools/canva-logo.png' },
  { nombre: 'Tailwind App', src: 'images/brand/tools/tailwind-logo.svg' },
  { nombre: 'Buffer', src: 'images/brand/tools/buffer-logo.png' },
  { nombre: 'Pinterest', src: 'images/brand/pinterest-logo.svg' },
];

const herramientasLoop = [...herramientas, ...herramientas];
---

<BaseLayout lang="es" title="Servicios de Esther Levy" path="servicios" altPath="en/services">
  <Header lang="es" altHref={`${base}en/services`} />

  <main>
    <section class="servicios-section reveal">
      <div class="section-inner">
        <h1>Cómo puedo ayudarte</h1>
        <div class="servicios-grid">
          {servicios.map(({ Icon, titulo, texto }) => (
            <div class="servicio-card reveal-card">
              <div class="servicio-icon-badge">
                <Icon size={28} />
              </div>
              <h3>{titulo}</h3>
              <div class="servicio-desc-wrap">
                <div class="servicio-desc-inner">
                  <p>{texto}</p>
                </div>
              </div>
              <a
                class="servicio-link"
                href={WHATSAPP_URL}
                target="_blank"
                rel="noopener noreferrer"
              >
                Contáctanos <span aria-hidden="true">→</span>
              </a>
            </div>
          ))}
        </div>

        <div class="servicios-main-cta-wrap">
          <a
            class="servicios-main-cta"
            href={WHATSAPP_URL}
            target="_blank"
            rel="noopener noreferrer"
          >
            Hablemos de tu proyecto
          </a>
        </div>
      </div>
    </section>

    <section class="precios-section reveal">
      <div class="section-inner">
        <h2>Content Repurposing — Paquetes y Precios</h2>
        <p class="precios-subtitulo">Precio por pieza de contenido (one off)</p>
        <div class="precios-grid">
          {planes.map(({ nombre, precio, sufijo, destacado, idealPara, filas }) => (
            <div class="precio-card reveal-card">
              {destacado && <span class="precio-badge">Más popular</span>}
              <p class="precio-nombre">{nombre}</p>
              <p class="precio-monto">
                <span class="precio-cifra">{precio}</span>
                <span class="precio-sufijo">{sufijo}</span>
              </p>
              <p class="precio-ideal"><strong>Ideal para:</strong> {idealPara}</p>
              <ul class="precio-filas">
                {filas.map(([label, valor]) => (
                  <li class="precio-fila">
                    <span class="precio-fila-label">{label}</span>
                    <span class="precio-fila-valor">{valor}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <p class="precios-footnote">
          Paquetes recurrentes o mensuales disponibles bajo pedido. Precios en USD. Comunicación vía Upwork o Telegram, sin llamadas.
        </p>
      </div>
    </section>

    <section class="proceso-section reveal">
      <div class="section-inner">
        <h2>Así de simple es empezar</h2>
        <div class="proceso-steps">
          {pasos.map(({ Icon, titulo, texto }, index) => (
            <div class="proceso-step reveal-card">
              <p class="proceso-number">{String(index + 1).padStart(2, '0')}</p>
              <div class="proceso-icon-badge">
                <Icon size={26} />
              </div>
              <h3>{titulo}</h3>
              <p>{texto}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="herramientas-section reveal">
      <div class="section-inner">
        <div class="herramientas-marquee">
          <div class="marquee-track">
            {herramientasLoop.map(({ nombre, src }, index) => (
              <div class="herramienta-logo-card" aria-hidden={index >= herramientas.length}>
                <img
                  src={`${base}${src}`}
                  alt={index < herramientas.length ? nombre : ''}
                  loading="lazy"
                />
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer lang="es" />
</BaseLayout>

<style>
  .section-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 4rem 1.25rem;
  }

  h1 {
    font-size: clamp(2rem, 4.5vw, 2.75rem);
    text-align: center;
    margin: 0 0 2.5rem;
  }

  h2 {
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    text-align: center;
    margin: 0 0 2.5rem;
  }

  /* Servicios */
  .servicios-section {
    background-color: var(--color-bg);
  }

  .servicios-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }

  .servicio-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    background-color: var(--color-surface);
    border: 1px solid rgba(78, 74, 87, 0.08);
    border-radius: 12px;
    padding: 1.75rem;
    box-shadow: 0 8px 30px rgba(78, 74, 87, 0.08);
    transition: background-color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .servicio-icon-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    color: var(--color-accent);
    margin-bottom: 1.25rem;
    transition: background-color 0.3s ease, border-color 0.3s ease, color 0.3s ease;
  }

  .servicio-card h3 {
    font-size: 1.2rem;
    margin: 0 0 0.75rem;
    transition: color 0.3s ease;
  }

  .servicio-desc-wrap {
    display: grid;
    grid-template-rows: 1fr;
    width: 100%;
  }

  .servicio-desc-inner {
    overflow: hidden;
  }

  .servicio-card p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text);
    margin: 0 0 1.5rem;
    transition: color 0.3s ease;
  }

  .servicio-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .servicio-link:hover {
    text-decoration: underline;
  }

  /* On devices with real hover (desktop mouse), the description starts
     collapsed and reveals on hover or keyboard focus. Touch devices never
     match this query, so the description stays visible by default. */
  @media (hover: hover) and (pointer: fine) {
    .servicio-desc-wrap {
      grid-template-rows: 0fr;
      transition: grid-template-rows 0.25s ease;
    }

    .servicio-card:hover .servicio-desc-wrap,
    .servicio-card:focus-within .servicio-desc-wrap {
      grid-template-rows: 1fr;
    }

    .servicio-card:hover,
    .servicio-card:focus-within {
      background-color: var(--color-accent-strong);
      border-color: var(--color-accent-strong);
      box-shadow: 0 4px 40px rgba(78, 74, 87, 0.12);
    }

    .servicio-card:hover h3,
    .servicio-card:focus-within h3,
    .servicio-card:hover p,
    .servicio-card:focus-within p,
    .servicio-card:hover .servicio-link,
    .servicio-card:focus-within .servicio-link {
      color: var(--color-cta-text);
    }

    .servicio-card:hover .servicio-icon-badge,
    .servicio-card:focus-within .servicio-icon-badge {
      background-color: rgba(255, 255, 255, 0.15);
      border-color: rgba(255, 255, 255, 0.4);
      color: var(--color-cta-text);
    }
  }

  .servicios-main-cta-wrap {
    display: flex;
    justify-content: center;
    margin-top: 3rem;
  }

  .servicios-main-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1rem;
    background-color: var(--color-accent-strong);
    color: var(--color-cta-text);
    border-radius: 999px;
    padding: 0.9rem 2.25rem;
    text-decoration: none;
    min-height: 48px;
    transition: filter 0.15s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .servicios-main-cta:hover {
    filter: brightness(0.9);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.12);
  }

  /* Precios */
  .precios-section {
    background-color: var(--color-bg);
  }

  .precios-section .section-inner {
    padding-top: 0;
  }

  .precios-section h2 {
    margin-bottom: 0.5rem;
  }

  .precios-subtitulo {
    text-align: center;
    color: var(--color-text-muted);
    font-size: 1rem;
    margin: 0 0 2.5rem;
  }

  .precios-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    align-items: stretch;
  }

  .precio-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background-color: var(--color-surface);
    border: 1px solid rgba(78, 74, 87, 0.08);
    border-radius: 12px;
    padding: 2rem 1.75rem 1.75rem;
    box-shadow: 0 8px 30px rgba(78, 74, 87, 0.08);
    transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .precio-card:hover {
      border-color: var(--color-accent);
      box-shadow: 0 4px 40px rgba(78, 74, 87, 0.12);
      transform: translateY(-4px);
    }
  }

  .precio-badge {
    position: absolute;
    top: -0.9rem;
    left: 50%;
    transform: translateX(-50%);
    background-color: var(--color-accent);
    color: var(--color-cta-text);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .precio-nombre {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    text-align: center;
    margin: 0 0 0.75rem;
  }

  .precio-monto {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.35rem;
    margin: 0 0 1rem;
  }

  .precio-cifra {
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 5vw, 2.75rem);
    color: var(--color-text);
  }

  .precio-sufijo {
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .precio-ideal {
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--color-text-muted);
    text-align: center;
    margin: 0 0 1.5rem;
  }

  .precio-ideal strong {
    color: var(--color-text);
  }

  .precio-filas {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin: 0;
    padding: 1.25rem 0 0;
    border-top: 1px solid var(--color-border);
    flex: 1;
  }

  .precio-fila {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .precio-fila-label {
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  .precio-fila-valor {
    color: var(--color-text);
    font-weight: 600;
    text-align: right;
  }

  .precios-footnote {
    text-align: center;
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    max-width: 640px;
    margin: 2.5rem auto 0;
  }

  /* Proceso */
  .proceso-section {
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .proceso-steps {
    display: flex;
    gap: 1.5rem;
  }

  .proceso-step {
    flex: 1;
    text-align: center;
    background-color: var(--color-surface);
    border: 1px solid rgba(78, 74, 87, 0.08);
    border-radius: 12px;
    padding: 1.75rem 1.5rem;
    box-shadow: 0 8px 30px rgba(78, 74, 87, 0.08);
    transition: box-shadow 0.3s ease, transform 0.3s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .proceso-step:hover {
      box-shadow: 0 4px 40px rgba(78, 74, 87, 0.12);
      transform: translateY(-4px);
    }
  }

  .proceso-number {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-text-muted);
    margin: 0 0 0.75rem;
  }

  .proceso-icon-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    margin: 0 auto 1rem;
    border-radius: 50%;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    color: var(--color-accent);
  }

  .proceso-step h3 {
    font-size: 1.05rem;
    margin: 0 0 0.5rem;
  }

  .proceso-step p {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* Herramientas */
  .herramientas-section {
    background-color: var(--color-bg);
  }

  .herramientas-marquee {
    display: flex;
    justify-content: center;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      black 8%,
      black 92%,
      transparent
    );
    mask-image: linear-gradient(
      to right,
      transparent,
      black 8%,
      black 92%,
      transparent
    );
  }

  .marquee-track {
    display: flex;
    align-items: center;
    gap: 4.5rem;
    width: max-content;
    animation: marquee-scroll 22s linear infinite;
  }

  .herramientas-marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  .herramienta-logo-card {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 68px;
  }

  .herramienta-logo-card img {
    height: 100%;
    width: auto;
    max-width: 220px;
    object-fit: contain;
  }

  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      width: 100%;
      gap: 3rem;
    }

    .herramienta-logo-card[aria-hidden='true'] {
      display: none;
    }
  }

  @media (max-width: 700px) {
    .proceso-steps {
      flex-direction: column;
    }

    .proceso-step {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .precios-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .section-inner {
      padding: 3rem 1rem;
    }

    .precios-section .section-inner {
      padding-top: 0;
    }
  }
</style>
