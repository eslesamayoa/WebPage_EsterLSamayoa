---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import AvatarPlaceholder from '../components/AvatarPlaceholder.astro';
import DecorativeBlob from '../components/DecorativeBlob.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout lang="es" title="Sobre mí, Esther Levy">
  <Header />

  <main>
    <section class="sobre-mi-section reveal">
      <div class="sobre-mi-inner">
        <div class="avatar-visual">
          <DecorativeBlob opacity={0.35} />
          <AvatarPlaceholder size={200} />
        </div>
        <div class="sobre-mi-content">
          <h1>Convierto tu contenido en tráfico que no se detiene.</h1>
          <p>
            Soy Esther Levy, asistente virtual especializada en Pinterest.
            Ayudo a dueñas de negocio y creadoras a dejar de perder tiempo
            tratando de entender el algoritmo de Pinterest, y en cambio,
            convertir su contenido existente en una fuente constante de
            tráfico y visibilidad.
          </p>
          <a
            class="linkedin-cta"
            href="https://www.linkedin.com/in/eslesamayoa/"
            target="_blank"
            rel="noopener noreferrer"
          >
            Conecta conmigo en LinkedIn
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .sobre-mi-section {
    background-color: var(--color-bg);
    padding: 4rem 1.25rem;
  }

  .sobre-mi-inner {
    max-width: 1000px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 3rem;
  }

  .avatar-visual {
    position: relative;
    width: 260px;
    height: 260px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
  }

  .sobre-mi-content {
    flex: 1;
    min-width: 0;
  }

  .sobre-mi-content h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.2;
    margin: 0 0 1.25rem;
  }

  .sobre-mi-content p {
    font-size: clamp(1rem, 1.8vw, 1.1rem);
    line-height: 1.7;
    color: var(--color-text);
    margin: 0 0 2rem;
    max-width: 55ch;
  }

  .linkedin-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1rem;
    background-color: transparent;
    color: var(--color-text);
    border: 2px solid var(--color-primary);
    border-radius: 999px;
    padding: calc(0.85rem - 2px) calc(1.75rem - 2px);
    text-decoration: none;
    min-height: 48px;
    transition: background-color 0.15s ease, transform 0.2s ease;
  }

  .linkedin-cta:hover {
    background-color: var(--color-surface);
    transform: translateY(-2px);
  }

  @media (max-width: 700px) {
    .sobre-mi-inner {
      flex-direction: column;
      text-align: center;
      gap: 2rem;
    }

    .sobre-mi-content p {
      margin-left: auto;
      margin-right: auto;
    }
  }

  @media (max-width: 480px) {
    .sobre-mi-section {
      padding: 3rem 1rem;
    }
  }
</style>
